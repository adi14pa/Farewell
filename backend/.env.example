# Neon Postgres — get this from your Neon project dashboard (Connection string, pooled)
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/tripplanner?sslmode=require

# SerpApi — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Groq — https://console.groq.com/keys (used for the planner/itinerary LLM reasoning steps)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

PORT=8080
